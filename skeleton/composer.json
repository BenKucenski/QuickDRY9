{
  "name": "your-vendor/your-app",
  "description": "A QuickDRY application",
  "type": "project",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/BenKucenski/QuickDRY9"
    }
  ],
  "require": {
    "php": ">=8.4",
    "benkucenski/quickdry9": "dev-main"
  },
  "scripts": {
    "post-install-cmd": [
      "@php vendor/benkucenski/quickdry9/bin/quickdry-publish"
    ],
    "post-update-cmd": [
      "@php vendor/benkucenski/quickdry9/bin/quickdry-publish"
    ]
  }
}
