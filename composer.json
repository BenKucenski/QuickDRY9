{
  "name": "benkucenski/quickdry9",
  "description": "QuickDRY: a lightweight PHP 8 web framework with MySQL/MSSQL connectors, code generation, and page routing.",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "Ben Kucenski",
      "email": "bkucenski@gmail.com"
    }
  ],
  "homepage": "https://github.com/BenKucenski/QuickDRY9",
  "require": {
    "php": ">=8.0",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "firebase/php-jwt": "^6.0 || ^7.0",
    "guzzlehttp/guzzle": "^7.0",
    "larapack/dd": "^1.1",
    "phpmailer/phpmailer": "^6.0 || ^7.0"
  },
  "suggest": {
    "ext-mysqli": "Required for the MySQL connector (QuickDRY\\Connectors\\mysql)",
    "ext-sqlsrv": "Required for the MSSQL connector (QuickDRY\\Connectors\\mssql)",
    "ext-odbc": "Required for the MS Access connector (QuickDRY\\Connectors\\ACCESS)"
  },
  "autoload": {
    "psr-4": {
      "QuickDRY\\": "QuickDRY/"
    },
    "files": [
      "QuickDRY/QuickDRY.php"
    ]
  },
  "bin": [
    "bin/quickdry-publish"
  ],
  "minimum-stability": "stable",
  "prefer-stable": true
}
